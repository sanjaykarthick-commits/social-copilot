# Copy to .env.local and fill in. Every value is read lazily: the app builds and serves public pages
# without them, and a feature whose variables are missing says exactly which ones (see SETUP_CHECKLIST.md).

# --- App -----------------------------------------------------------------------------------------
# Your live https domain in production. Locally, an ngrok https URL when testing OAuth (Instagram and
# LinkedIn only redirect to https). Run `npm run doctor` to check everything and print the URLs to register.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on /privacy and /terms (Meta and Google reviewers look for it).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Clerk (auth) --------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the webhook endpoint registered at <APP_URL>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Neon pooled connection string, or any Postgres) -----------------------------------
DATABASE_URL=

# --- Token encryption (OAuth tokens are AES-256-GCM encrypted at rest) ---------------------------
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- X (Twitter) OAuth 2.0 (optional) ------------------------------------------------------------
# Callback URL in the X developer console must be exactly <APP_URL>/api/oauth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Google / YouTube OAuth ----------------------------------------------------------------------
# Authorized redirect URI must be exactly <APP_URL>/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (Meta app) ------------------------------------------------------------------------
# New apps ("API setup with Unified login"): the Meta App ID and App secret from App settings > Basic,
# plus the Configuration ID from the unified login page.
# Older apps ("API setup with Instagram login"): the INSTAGRAM app ID and secret from that page, no config ID.
# Redirect URL in both cases: <APP_URL>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
# Unified login stopgap: your Instagram account id, when Meta's token does not say which account it grants.
INSTAGRAM_ACCOUNT_ID=

# --- LinkedIn (linkedin.com/developers > your app > Auth) ----------------------------------------
# Products needed: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" (both self-serve).
# Redirect URL: <APP_URL>/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only after LinkedIn approves your app for the Community Management API (post stats + reading comments):
# LINKEDIN_EXTRA_SCOPES=r_member_social r_member_postAnalytics
# LinkedIn-Version header (YYYYMM). Each version is supported for about a year.
# LINKEDIN_API_VERSION=202610

# --- ImageKit (media storage) --------------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# --- Inngest (scheduler) -------------------------------------------------------------------------
# Local only: run `npm run inngest:dev` and set INNGEST_DEV=1. REMOVE it in production.
INNGEST_DEV=1
# Production: injected by the Vercel integration.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
